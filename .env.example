DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
PORT=3100
SERVE_UI=false
BETTER_AUTH_SECRET=paperclip-dev-secret
THINKINGMACH_TOOL_ACTION_SIGNING_SECRET=paperclip-dev-tool-action-signing-secret-change-me

# Optional ThinkingMach ID Gmail OAuth broker. Enroll the instance first; keep both
# private keys in the deployment secret manager. HTTP base URLs must be loopback.
# THINKINGMACH_ID_CONNECTOR_BASE_URL=http://localhost:3000
# THINKINGMACH_ID_CONNECTOR_ENVIRONMENT=development
# THINKINGMACH_ID_CONNECTOR_INSTANCE_ID=inst_example
# THINKINGMACH_ID_CONNECTOR_SIGN_PRIVATE_KEY=
# THINKINGMACH_ID_CONNECTOR_SEAL_PRIVATE_KEY=

# Process-wide protection for expensive full-tree workspace Git scans.
# THINKINGMACH_WORKSPACE_GIT_SCAN_CONCURRENCY=2
# THINKINGMACH_WORKSPACE_GIT_SCAN_QUEUE_CAPACITY=32
# THINKINGMACH_WORKSPACE_GIT_SCAN_TIMEOUT_MS=8000
# THINKINGMACH_WORKSPACE_GIT_SCAN_CACHE_TTL_MS=10000

# HTTP adapters may call public HTTP(S) origins by default. Opt trusted private
# origins in explicitly; entries are exact origins (scheme, host, and port).
# THINKINGMACH_HTTP_ADAPTER_PRIVATE_ENDPOINT_ALLOWLIST=http://hooks.internal.example:8080

# Discord webhook for daily merge digest (scripts/discord-daily-digest.sh)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
